{
  "name": "banana-cat-backend",
  "version": "1.0.0",
  "description": "索引器 + API, 监听香蕉猫 Launchpad 所有链上事件",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "psql -U postgres -d bananacat < db/schema.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.1",
    "viem": "^2.56.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.9.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}

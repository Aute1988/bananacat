# ============================================================
# 香蕉猫 Launchpad - Backend 配置示例
# 复制此文件为 .env,根据需要修改
# ============================================================

# ---- 服务器 ----
PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bananacat

# ---- 跨域 ----
# 开发环境:*
# 生产环境:逗号分隔的域名,例:https://bananacat.app,https://www.bananacat.app
CORS_ORIGIN=*

# ============================================================
# 区块链 RPC(全部是公开免费节点,生产环境建议换付费节点)
# ============================================================

# BNB Smart Chain 测试网
BSC_RPC=https://rpc.ankr.com/bsc_testnet_chapel
BSC_FACTORY=  # ← 必须填,部署后填合约地址

# Ethereum Sepolia 测试网
ETH_RPC=https://rpc.sepolia.org
ETH_FACTORY=

# Robinhood Chain 测试网(Arbitrum Orbit L2)
ROBINHOOD_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_FACTORY=

# Circle Arc 测试网
ARC_RPC=https://rpc.testnet.arc.io
ARC_FACTORY=

# ============================================================
# 浏览器链接(用于通知跳转)
# ============================================================

EXPLORER_97=https://testnet.bscscan.com
EXPLORER_11155111=https://sepolia.etherscan.io
EXPLORER_46630=https://testnet-explorer.robinhood.com
EXPLORER_5042002=https://testnet-explorer.arc.io

# ============================================================
# 索引器
# ============================================================
SYNC_FROM_BLOCK=0  # 从哪个区块开始同步(0 = 链创世)

# ============================================================
# 通知(可选)
# ============================================================
LARGE_TRADE_THRESHOLD_WEI=1000000000000000000  # 1 native 视为大额交易

# ============================================================
# IPFS(可选,至少填一个,否则用本地 fallback)
# ============================================================

# Pinata(推荐): https://www.pinata.cloud
PINATA_JWT=

# Infura IPFS: https://infura.io/product/ipfs
INFURA_PROJECT_ID=
INFURA_PROJECT_SECRET=

# ============================================================
# 缓存(可选,生产环境推荐用 Redis)
# ============================================================
REDIS_URL=redis://localhost:6379  # 不填就用内存缓存
